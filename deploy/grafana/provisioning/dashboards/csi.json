{
  "title": "CSI Sensing",
  "uid": "csi-sensing",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Respiration rate (bpm)",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 40 } },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"csi\" and r._field == \"bpm\")",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Presence",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "empty" }, "1": { "text": "PRESENT" } } }
          ],
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"csi\" and r._field == \"presence\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Confidence",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"csi\" and r._field == \"confidence\")",
          "refId": "A"
        }
      ]
    }
  ]
}
